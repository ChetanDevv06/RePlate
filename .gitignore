# ============================================================
# RePlate Root — Git Ignore Rules
# ============================================================

# Dependencies
**/node_modules/

# Next.js Build Output & Cache
**/.next/
**/out/
**/build/
**/dist/

# Environment Variables & Secrets (CRITICAL)
**/.env
**/.env*.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/*.pem
**/*.key
**/*.cert
**/*.crt
**/*.pfx
**/*.p12

# Allow committing template env files
!**/.env.example

# Debug & Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# Vercel
**/.vercel/

# TypeScript Cache
**/*.tsbuildinfo

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
