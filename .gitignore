# ============================================================
# RePlate — Git Ignore Rules
# ============================================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output & Cache
.next/
out/
build/
dist/

# Environment Variables & Secrets (CRITICAL)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Allow committing template/example env files
!.env.example

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Vercel & Deployment
.vercel/

# TypeScript Cache
*.tsbuildinfo
next-env.d.ts

# Operating System & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Configs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.history/
